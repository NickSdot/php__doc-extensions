<?xml version="1.0" encoding="utf-8"?>
<!-- $Revision$ -->
<!--

This is a translatable XML Entity file.
See doc-base/scripts/text-entities.php for details.

Everything about acronyms resides in this file, as two kinds of
entities:

- Acronym definitions, entities named after the acronym itself
  (for example &php;), which render the term wrapped in an
  <acronym> tag;
- Acronym expansions, entities named acronym.expansion.<term>,
  where <term> is the exact text used inside <acronym> tags,
  holding the expanded meaning of the term.

Besides being collected by text-entities.php like any other
entity file, this file is also read directly, as a plain XML
document, by automated tools:

- PhD loads it to generate the expansion tooltips of <acronym>
  tags (see phd/phpdotnet/phd/Package/PHP/XHTML.php);
- doc-base/scripts/qa/check-acronyms.php uses it to report
  statistics about defined and used acronyms.

Because of these direct uses, some extra restrictions apply:

- The contents of acronym.expansion.* entities must be plain
  text: no child XML elements;
- No entity in this file may contain references to other
  entities;
- Entities that are not acronym definitions or expansions do not
  belong in this file, and are ignored by the tools above.

Both groups should be listed in alphabetical order.

-->

<entities xmlns       = "http://docbook.org/ns/docbook"
          translate   = "yes">

<!-- Acronym definitions -->

<!-- Acronym expansions -->

<entity name="acronym.expansion.CA">Certificate Authority</entity>
<entity name="acronym.expansion.EOF">End Of File</entity>
<entity name="acronym.expansion.HTTP">Hypertext Transfer Protocol</entity>
<entity name="acronym.expansion.PECL">PHP Extension Community Library</entity>
<entity name="acronym.expansion.PEM">Privacy-Enhanced Mail</entity>
<entity name="acronym.expansion.PHP">PHP: Hypertext Preprocessor</entity>
<entity name="acronym.expansion.RGB">Red-Green-Blue</entity>
<entity name="acronym.expansion.SAPI">Server Application Programming Interface</entity>
<entity name="acronym.expansion.URI">Uniform Resource Identifier</entity>

</entities>
